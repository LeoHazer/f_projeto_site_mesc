APP_NAME="Portal MESC"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=mesc_dev
DB_USERNAME=mesc
DB_PASSWORD=mesc_dev

# Para desenvolvimento local com SQLite, comente o bloco acima e use:
#DB_CONNECTION=sqlite
#DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database

VITE_APP_NAME="${APP_NAME}"
